# macOS
.DS_Store

# Git worktree slots (local workspaces, not repo content)
.worktrees/

# Editor / tooling
.claude/
.vscode/
node_modules/

# Secrets / logs
.env
.env.*
*.log

# Impeccable design tooling (local session state, not product)
