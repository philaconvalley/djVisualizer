# macOS
.DS_Store

# Git worktree slots (local workspaces, not repo content)
.worktrees/

# Editor / tooling
.claude/
.vscode/
node_modules/

# Secrets / logs
.env
.env.*
*.log

# Impeccable design tooling: config.json is shared project config (detector
# settings, hook toggle) and should be committed; only the per-developer
# override file is local state.
.impeccable/config.local.json

# Playwright scratch
.playwright-mcp/

# Verification harness artefacts. Fixtures are generated (npm run fixtures);
# output is screenshots and a results file from the last run.
test/fixtures/*.wav
test/output/

# Written by the Netlify build so CI can tell which commit is live.
build-info.json
